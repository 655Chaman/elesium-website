# ─────────────────────────────────────────────────────
# Elesium SEO Automation — Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────
# Google Gemini API Key (FREE tier available)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPTIONAL: DataForSEO (keyword volume data) ───────
# Free sandbox available at: https://app.dataforseo.com/register
# Without this, the pipeline still works — just without search volume numbers.
DATAFORSEO_LOGIN=your_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password

# ── OPTIONAL: SerpAPI (alternative keyword data) ─────
# 100 free searches/month at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here
