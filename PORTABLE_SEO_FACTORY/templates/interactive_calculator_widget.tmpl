<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{TOOL_NAME}} | {{BRAND_NAME}} Micro-SaaS Engine</title>
  <meta name="description" content="Simulate enterprise ROI, token cost arbitrage, and latency gains with {{BRAND_NAME}}'s interactive {{TOOL_NAME}}.">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @layer utilities {
      .font-mono-num { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans p-4 md:p-6 antialiased">

  <!-- Interactive Simulator Card Container -->
  <div class="max-w-2xl mx-auto bg-slate-900 border border-slate-800 rounded-xl p-5 md:p-8 shadow-2xl relative overflow-hidden">
    <!-- Ambient Glow Accent -->
    <div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header & Live Telemetry Badge -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 border-b border-slate-800/80 pb-4">
      <div>
        <span class="text-[10px] uppercase font-mono-num tracking-widest text-cyan-400 font-semibold">Institutional Micro-SaaS Linkable Asset</span>
        <h2 class="text-xl md:text-2xl font-extrabold text-white tracking-tight mt-0.5">
          {{TOOL_NAME}}
        </h2>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono-num bg-cyan-950/80 border border-cyan-800/60 text-cyan-300">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          Sub-200ms FSM Model
        </span>
      </div>
    </div>

    <!-- Simulator Form Controls -->
    <div class="space-y-5 mb-8">
      <!-- Input 1: Monthly Operations / Transaction Volume -->
      <div>
        <div class="flex justify-between text-xs font-mono-num mb-2 text-slate-300">
          <label for="volumeSlider">Monthly Workflow Operations</label>
          <span id="volumeValue" class="text-cyan-400 font-bold">50,000 ops</span>
        </div>
        <input type="range" id="volumeSlider" min="5000" max="500000" step="5000" value="50000"
               class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400">
        <div class="flex justify-between text-[10px] text-slate-500 font-mono-num mt-1">
          <span>5k</span>
          <span>100k</span>
          <span>250k</span>
          <span>500k ops/mo</span>
        </div>
      </div>

      <!-- Input 2: Current Manual Cycle Time (Minutes per execution) -->
      <div>
        <div class="flex justify-between text-xs font-mono-num mb-2 text-slate-300">
          <label for="timeSlider">Manual Verification Latency (Minutes / Case)</label>
          <span id="timeValue" class="text-cyan-400 font-bold">18 min</span>
        </div>
        <input type="range" id="timeSlider" min="2" max="60" step="1" value="18"
               class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400">
        <div class="flex justify-between text-[10px] text-slate-500 font-mono-num mt-1">
          <span>2 min (Fast)</span>
          <span>30 min</span>
          <span>60 min (Complex Underwriting)</span>
        </div>
      </div>

      <!-- Input 3: Fully Loaded Human Operator Cost ($ / Hour or INR equivalent) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="laborRate" class="block text-xs font-mono-num mb-1.5 text-slate-300">Blended Operator Cost ($ / hr)</label>
          <input type="number" id="laborRate" value="32" min="10" max="250"
                 class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white font-mono-num focus:outline-none focus:border-cyan-400">
        </div>
        <div>
          <label for="tokenWaste" class="block text-xs font-mono-num mb-1.5 text-slate-300">Baseline Prompt Token Waste (%)</label>
          <input type="number" id="tokenWaste" value="65" min="0" max="95"
                 class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white font-mono-num focus:outline-none focus:border-cyan-400">
        </div>
      </div>
    </div>

    <!-- Output Telemetry Matrix -->
    <div class="bg-slate-950 border border-slate-800 rounded-xl p-5 mb-6">
      <div class="text-xs font-mono-num uppercase tracking-wider text-slate-400 mb-3 font-semibold">
        Simulated Operational Impact (Deterministic Telemetry)
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-center">
        <!-- Metric 1: Monthly Cost Savings -->
        <div class="p-3 bg-slate-900/80 rounded-lg border border-slate-800">
          <div class="text-[10px] text-slate-400 font-mono-num">Monthly Net Savings</div>
          <div id="monthlySavings" class="text-xl md:text-2xl font-extrabold text-emerald-400 font-mono-num mt-1">$44,800</div>
          <div class="text-[9px] text-slate-500 mt-0.5">85% labor + token recovery</div>
        </div>

        <!-- Metric 2: Turnaround Reduction -->
        <div class="p-3 bg-slate-900/80 rounded-lg border border-slate-800">
          <div class="text-[10px] text-slate-400 font-mono-num">Throughput Acceleration</div>
          <div id="speedupFactor" class="text-xl md:text-2xl font-extrabold text-cyan-400 font-mono-num mt-1">98.2%</div>
          <div class="text-[9px] text-slate-500 mt-0.5">&lt; 1.5s FSM transition</div>
        </div>

        <!-- Metric 3: Projected Annual ROI Multiple -->
        <div class="p-3 bg-slate-900/80 rounded-lg border border-slate-800 col-span-2 sm:col-span-1">
          <div class="text-[10px] text-slate-400 font-mono-num">Capital ROI Multiple</div>
          <div id="roiMultiple" class="text-xl md:text-2xl font-extrabold text-purple-400 font-mono-num mt-1">11.4x</div>
          <div class="text-[9px] text-slate-500 mt-0.5">Breakeven &lt; 21 days</div>
        </div>
      </div>

      <!-- Dynamic Visual Progress Bar -->
      <div class="mt-4 pt-4 border-t border-slate-800/80">
        <div class="flex justify-between text-xs font-mono-num text-slate-400 mb-1">
          <span>Manual Queue Backlog</span>
          <span class="text-cyan-400">Autonomous Settlement</span>
        </div>
        <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden flex">
          <div id="progressBar" class="bg-gradient-to-r from-cyan-400 to-emerald-400 h-full transition-all duration-300" style="width: 88%"></div>
        </div>
      </div>
    </div>

    <!-- Conversion & Embed Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
      <a href="{{DOMAIN_URL}}{{PRIMARY_CTA_URL}}" 
         class="w-full sm:w-auto inline-flex justify-center items-center px-5 py-2.5 bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-lg transition-all shadow-lg shadow-cyan-500/20">
        Lock 90-Day ROI Guarantee
      </a>

      <!-- Viral Embed Modal Trigger -->
      <button onclick="toggleEmbedCode()" class="text-xs font-mono-num text-slate-400 hover:text-cyan-400 underline underline-offset-4 transition-colors">
        &lt;/&gt; Embed Widget on Your Website
      </button>
    </div>

    <!-- Hidden Embed Code Container -->
    <div id="embedModal" class="hidden mt-4 p-3 bg-slate-950 border border-slate-800 rounded-lg text-xs">
      <p class="text-slate-400 font-mono-num mb-1.5">Copy this embed snippet (Includes authoritative watermark):</p>
      <textarea readonly class="w-full bg-slate-900 border border-slate-800 text-slate-300 font-mono-num p-2 rounded text-[11px] h-20 select-all focus:outline-none">&lt;iframe src="{{DOMAIN_URL}}/embed/{{TOOL_SLUG}}" width="100%" height="520" frameborder="0" style="border-radius: 12px; border: 1px solid #1e293b;"&gt;&lt;/iframe&gt;
&lt;p style="font-size: 11px; color: #64748b; font-family: monospace;"&gt;Calculated via &lt;a href="{{DOMAIN_URL}}" target="_blank" style="color: #06b6d4;"&gt;{{BRAND_NAME}} Enterprise AI&lt;/a&gt;&lt;/p&gt;</textarea>
    </div>

    <!-- Authoritative Watermark Backlink (Embed Mode Protection) -->
    <div class="mt-6 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-num text-slate-500">
      <span>Model: Institutional Delta-WAL v4.2</span>
      <span>Calculated via <a href="{{DOMAIN_URL}}" target="_blank" class="text-cyan-400 hover:underline font-semibold">{{BRAND_NAME}}</a></span>
    </div>
  </div>

  <!-- Interactive Logic Engine -->
  <script>
    const volumeSlider = document.getElementById('volumeSlider');
    const timeSlider = document.getElementById('timeSlider');
    const laborRateInput = document.getElementById('laborRate');
    const tokenWasteInput = document.getElementById('tokenWaste');

    const volumeValue = document.getElementById('volumeValue');
    const timeValue = document.getElementById('timeValue');
    const monthlySavings = document.getElementById('monthlySavings');
    const speedupFactor = document.getElementById('speedupFactor');
    const roiMultiple = document.getElementById('roiMultiple');
    const progressBar = document.getElementById('progressBar');

    function calculateImpact() {
      const volume = parseFloat(volumeSlider.value);
      const minutes = parseFloat(timeSlider.value);
      const hourlyRate = parseFloat(laborRateInput.value) || 30;
      const tokenWaste = parseFloat(tokenWasteInput.value) || 50;

      // Update Slider Labels
      volumeValue.textContent = volume.toLocaleString() + " ops";
      timeValue.textContent = minutes + " min";

      // 1. Manual baseline monthly labor cost = (volume * minutes / 60) * hourlyRate
      const manualHours = (volume * minutes) / 60;
      const manualLaborCost = manualHours * hourlyRate;

      // 2. Automated execution cost under sovereign agent (assume 94% automation efficiency)
      const automatedCost = (volume * 0.015) + (manualLaborCost * 0.06);
      
      // 3. Token waste salvage
      const rawTokenSpend = volume * 0.035;
      const tokenSavings = rawTokenSpend * (tokenWaste / 100);

      const netMonthlySavings = Math.round((manualLaborCost - automatedCost) + tokenSavings);
      const annualSavings = netMonthlySavings * 12;

      // Typical Enterprise Suite pilot implementation amortization ($12,000)
      const implementationCost = 12000;
      const computedROI = (annualSavings / implementationCost).toFixed(1);

      // Render Telemetry
      monthlySavings.textContent = "$" + netMonthlySavings.toLocaleString();
      roiMultiple.textContent = Math.max(2.1, computedROI) + "x";

      // Calculate Speedup & Bar
      const speedup = Math.min(99.6, Math.max(92.0, (100 - (1.5 / (minutes * 60)) * 100))).toFixed(1);
      speedupFactor.textContent = speedup + "%";
      progressBar.style.width = Math.min(98, Math.max(60, speedup)) + "%";
    }

    function toggleEmbedCode() {
      const modal = document.getElementById('embedModal');
      modal.classList.toggle('hidden');
    }

    volumeSlider.addEventListener('input', calculateImpact);
    timeSlider.addEventListener('input', calculateImpact);
    laborRateInput.addEventListener('input', calculateImpact);
    tokenWasteInput.addEventListener('input', calculateImpact);

    // Initial compute on mount
    calculateImpact();
  </script>
</body>
</html>
