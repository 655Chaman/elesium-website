  <Document>
    <name>Elesium Enterprise AI - Mumbai Entity Authority &amp; Driving Directions</name>
    <description><![CDATA[
      <h3>Elesium Enterprise AI Architecture Hub - Mumbai</h3>
      <p><b>Address:</b> Bandra Kurla Complex (BKC), G Block, Mumbai, Maharashtra 400051</p>
      <p><b>Coordinates:</b> <a href="https://maps.google.com/?q=19.0657,72.8687">GPS: 19.0657, 72.8687</a></p>
      <p><b>Official Entity URL:</b> <a href="https://elesium.online/enterprise-ai-mumbai/">https://elesium.online/enterprise-ai-mumbai/</a></p>
      <p><b>Autonomous AI Engineering:</b> Multi-Agent LangGraph Systems, Sovereign LLM Deployment, DPDP Act 2023 Compliance.</p>
      <p><b>Architecture Walkthroughs:</b> <a href="https://elesium.online/videos/">https://elesium.online/videos/</a></p>
    ]]></description>
    <Style id="hubPoint">
      <IconStyle>
        <scale>1.4</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-stars.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="vectorRoute">
      <LineStyle>
        <color>ff0000ff</color>
        <width>4</width>
      </LineStyle>
    </Style>
    <Style id="radiusBoundary">
      <LineStyle><color>7f00ffff</color><width>2</width></LineStyle>
      <PolyStyle><color>1aff0000</color></PolyStyle>
    </Style>

    <!-- FOCAL HUB PLACEMARK -->
    <Placemark>
      <name>Elesium Enterprise AI Headquarters - Mumbai</name>
      <description>Primary sovereign AI state machine development center. GPS: 19.0657, 72.8687</description>
      <styleUrl>#hubPoint</styleUrl>
      <Point>
        <coordinates>72.8687,19.0657,0</coordinates>
      </Point>
    </Placemark>

